# macOS / editor noise
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~

# Dependencies and package-manager caches
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local development output
/dist/
/build/
/.vite/
/coverage/

# Python helper caches
__pycache__/
*.py[cod]
*$py.class

# Temporary generated/intermediate ImageGen files
/tmp/

# OMX/Codex runtime state and logs - not project source
/.omx/

# Local env/secrets
.env
.env.*
!.env.example

# Browser/test artifacts
/playwright-report/
/test-results/
/screenshots/

# Local Superpowers runtime state
/.superpowers/
/.worktrees/
